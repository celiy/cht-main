{
    "name": "cht-main",
    "private": true,
    "type": "module",
    "bin": {
        "chtmain": "scripts/entry.mjs"
    },
    "scripts": {
        "cht": "node scripts/entry.mjs",
        "install:repos": "node scripts/entry.mjs install",
        "dev": "node scripts/entry.mjs dev",
        "build": "node scripts/entry.mjs build",
        "electron": "node scripts/entry.mjs electron",
        "bump": "node scripts/entry.mjs bump",
        "sync:deps": "node scripts/entry.mjs sync-deps",
        "sync:tsconfig": "node scripts/entry.mjs sync-tsconfig",
        "lint": "eslint cht-base cht-design-system cht-shared",
        "lint:fix": "npm run lint -- --fix",
        "format": "prettier --write \"cht-base/**/*.{vue,ts,js,css,json,md}\" \"cht-design-system/**/*.{vue,ts}\" \"cht-shared/**/*.{ts,js,json,md}\" \".cursor/**/*.{md,mdc}\"",
        "format:check": "prettier --check \"cht-base/**/*.{vue,ts,js,css,json,md}\" \"cht-design-system/**/*.{vue,ts}\" \"cht-shared/**/*.{ts,js,json,md}\" \".cursor/**/*.{md,mdc}\""
    },
    "dependencies": {
        "ink": "^7.0.1",
        "ink-spinner": "^5.0.0",
        "react": "^19.2.5"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@prettier/sync": "^0.6.1",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.5.1",
        "globals": "^16.4.0",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.7.1",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.21.0",
        "typescript-eslint": "^8.46.2"
    }
}
