{
    "semi": true,
    "singleQuote": false,
    "tabWidth": 4,
    "useTabs": false,
    "trailingComma": "none",
    "printWidth": 100,
    "plugins": ["prettier-plugin-tailwindcss"],
    "tailwindStylesheet": "./cht-base/src/css/style.css",
    "overrides": [
        {
            "files": "*.mdc",
            "options": {
                "parser": "markdown"
            }
        }
    ]
}
